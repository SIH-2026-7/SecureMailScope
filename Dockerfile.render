FROM node:22-alpine AS frontend
WORKDIR /site
COPY package*.json ./
RUN npm ci
COPY index.html vite.config.js postcss.config.js ./
COPY src src
COPY public public
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends tshark && rm -rf /var/lib/apt/lists/*
WORKDIR /service
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app app
COPY --from=frontend /site/dist /service/web
ENV STATIC_DIR=/service/web DATA_DIR=/tmp/securemailscope
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
